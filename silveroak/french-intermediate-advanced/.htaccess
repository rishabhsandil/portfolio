RewriteEngine On

# Redirect /french-intermediate-advanced/index.html to the clean directory URL
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

DirectoryIndex index.html

# mail.php answers JSON and must never be cached
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>

  # Static assets are cache-busted with ?v= in the markup, so they can sit a long time
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

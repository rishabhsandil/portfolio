RewriteEngine On

# Redirect /french-intermediate-advanced/index.html to the clean directory URL
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

DirectoryIndex index.html

# mail.php answers JSON and must never be cached
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
  </FilesMatch>

  # The markup must always be revalidated. It carries the ?v= hashes that point at
  # the current CSS and JS, so a cached copy of it pins the whole page to old
  # assets no matter how the assets themselves are cached. "no-cache" still allows
  # a 304, so this costs a conditional request, not a full download.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Assets are addressed by a hash of their own contents (see stamp.py), so a given
  # URL can never point at different bytes. That makes them safe to pin, and
  # "immutable" stops browsers revalidating them on reload.
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
